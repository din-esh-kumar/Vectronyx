# VECTRONYX AI WORKBENCH — Backend Environment Variables Sample
APP_NAME=Vectronyx AI Workbench
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
PORT=8000
DATABASE_URL=abc
SUPABASE_SERVICE_ROLE_KEY=abc
SUPABASE_URL=abc
SUPABASE_PUBLISHABLE_KEY=abc
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# LLM Configuration (Groq / Ollama)
# ----------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# FAISS Vector Store
# ----------------------------
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIMENSION=384

# ----------------------------
# Research Agent
# ----------------------------
MAX_SEARCH_RESULTS=5
MAX_SCRAPE_DEPTH=2

# ----------------------------
# Supabase Storage & Vector Store
# ----------------------------
SUPABASE_STORAGE_BUCKET=datasets
VECTOR_STORE_PROVIDER=supabase_pgvector

# ----------------------------
# CORS
# ----------------------------
ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------
# Cloud LLM — Google Gemini
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

